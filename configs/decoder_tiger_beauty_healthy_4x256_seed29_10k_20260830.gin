import data.processed
train.iterations=10000
train.learning_rate=0.001
train.weight_decay=0.0001
train.batch_size=640
train.seed=29
train.wandb_logging=False
train.pretrained_rqvae_path="out/rqvae/tiger_beauty_healthy_E1_kaiming_epoch100_export_20260830/model_best_total_loss_state_dict.pt"
train.save_dir_root="out/decoder/tiger_beauty_healthy_4x256_seed29_10k_20260830/"
train.save_model_every=1000
train.dataset_folder="dataset/amazon-p5"
train.dataset=%data.processed.RecDataset.AMAZON
train.force_dataset_process=False
train.partial_eval_every=5000
train.full_eval_every=1000
train.dataset_split="beauty"
train.vae_input_dim=768
train.vae_hidden_dims=[512,256,128]
train.vae_embed_dim=32
train.vae_n_cat_feats=0
train.vae_codebook_size=256
train.vae_n_layers=3
train.t5_d_model=384
train.t5_num_heads=6
train.t5_d_ff=1024
train.t5_num_layers=4
train.top_k_for_generation=10
train.should_add_sep_token=True
train.tiger_token_policy="paper/full-id"
train.full_id_suffix_cardinality=256
train.paper_aligned=True
train.num_user_bins=2000
train.user_token_policy="modulo_hashed_bucket"
train.user_bin_mode="paper_fixed"
train.user_bin_cap=2000
train.evaluator_policy="native_semantic_id"
