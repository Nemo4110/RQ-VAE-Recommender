import train_rqvae_healthy

# Healthy-local-improvement lane only.  Reset-every-2 passed every complete-
# corpus snapshot through 120 updates.  This is its isolated 100-epoch export
# gate, with every other E1 setting preserved and new artifacts only.
train_rqvae_healthy.train.arm_name = 'E1_kaiming_reset2_warmup_epoch100_export'
train_rqvae_healthy.train.output_dir = 'out/rqvae/tiger_beauty_healthy_E1_reset2_epoch100_export_20260831'
train_rqvae_healthy.train.dataset_folder = 'dataset/amazon-p5'
train_rqvae_healthy.train.dataset_split = 'beauty'
train_rqvae_healthy.train.expected_num_items = 12101
train_rqvae_healthy.train.seed = 20260830
train_rqvae_healthy.train.epochs = 100
train_rqvae_healthy.train.max_optimizer_steps = 1200
train_rqvae_healthy.train.batch_size = 1024
train_rqvae_healthy.train.learning_rate = 0.001
train_rqvae_healthy.train.weight_decay = 0.0001
