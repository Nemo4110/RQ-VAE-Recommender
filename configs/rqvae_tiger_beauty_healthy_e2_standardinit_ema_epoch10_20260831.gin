import train_rqvae_healthy

# E2-inspired 10-epoch gate, enabled only after the matching one-batch and
# one-epoch full-corpus gates passed.  Preserve all mechanisms; snapshots every
# 12 updates retain bounded cost while stop_on_failed_health_gate remains on.
train_rqvae_healthy.train.arm_name = 'E2_inspired_standardinit_ema_reset_warmup_epoch10'
train_rqvae_healthy.train.output_dir = 'out/rqvae/tiger_beauty_healthy_E2_standardinit_ema_epoch10_20260831'
train_rqvae_healthy.train.dataset_folder = 'dataset/amazon-p5'
train_rqvae_healthy.train.dataset_split = 'beauty'
train_rqvae_healthy.train.expected_num_items = 12101
train_rqvae_healthy.train.seed = 20260830
train_rqvae_healthy.train.epochs = 10
train_rqvae_healthy.train.max_optimizer_steps = 120
train_rqvae_healthy.train.batch_size = 1024
train_rqvae_healthy.train.learning_rate = 0.001
train_rqvae_healthy.train.weight_decay = 0.0001
train_rqvae_healthy.train.warmup_steps = 50
train_rqvae_healthy.train.use_ema_codebook = True
train_rqvae_healthy.train.ema_decay = 0.99
train_rqvae_healthy.train.dead_code_reset_every = 1
train_rqvae_healthy.train.use_kaiming_relu_initialization = False
train_rqvae_healthy.train.codebook_normalize = False
train_rqvae_healthy.train.gumbel_temperature = 0.2
train_rqvae_healthy.train.suffix_capacity = 256
train_rqvae_healthy.train.minimum_usage = 0.80
train_rqvae_healthy.train.snapshot_every_steps = 12
train_rqvae_healthy.train.stop_on_failed_health_gate = True
