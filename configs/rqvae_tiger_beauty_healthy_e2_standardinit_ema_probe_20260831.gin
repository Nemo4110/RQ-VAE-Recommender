import train_rqvae_healthy

# Provenance-backed E2-inspired EMA isolation.  Historical E2 combined EMA and
# dead-code recovery under a non-Kaiming common initialization; current E5 used
# Kaiming and failed its one-epoch usage gate.  This is NOT a literal historical
# common-state replay: it uses the current fresh standard PyTorch initialization
# plus current k-means, corrected unit-mass EMA bootstrap, per-step reset, and
# the existing warmup.  It changes only use_kaiming_relu_initialization from the
# corrected E5 one-batch arm and must pass this one-step corpus gate first.
train_rqvae_healthy.train.arm_name = 'E2_inspired_standardinit_ema_reset_warmup_probe'
train_rqvae_healthy.train.output_dir = 'out/rqvae/tiger_beauty_healthy_E2_standardinit_ema_probe_20260831'
train_rqvae_healthy.train.dataset_folder = 'dataset/amazon-p5'
train_rqvae_healthy.train.dataset_split = 'beauty'
train_rqvae_healthy.train.expected_num_items = 12101
train_rqvae_healthy.train.seed = 20260830
train_rqvae_healthy.train.epochs = 1
train_rqvae_healthy.train.max_optimizer_steps = 1
train_rqvae_healthy.train.batch_size = 1024
train_rqvae_healthy.train.learning_rate = 0.001
train_rqvae_healthy.train.weight_decay = 0.0001
train_rqvae_healthy.train.warmup_steps = 50
train_rqvae_healthy.train.use_ema_codebook = True
train_rqvae_healthy.train.ema_decay = 0.99
train_rqvae_healthy.train.dead_code_reset_every = 1
train_rqvae_healthy.train.use_kaiming_relu_initialization = False
train_rqvae_healthy.train.codebook_normalize = False
train_rqvae_healthy.train.gumbel_temperature = 0.2
train_rqvae_healthy.train.suffix_capacity = 256
train_rqvae_healthy.train.minimum_usage = 0.80
train_rqvae_healthy.train.snapshot_every_steps = 1
train_rqvae_healthy.train.stop_on_failed_health_gate = True
