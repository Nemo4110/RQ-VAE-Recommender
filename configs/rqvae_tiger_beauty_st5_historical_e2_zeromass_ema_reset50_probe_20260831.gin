import train_rqvae_healthy

# Source-code reconstruction of historical E2's EMA mechanics.  The archived
# common-init artifact is intentionally not loaded because it needs unsafe
# pickle deserialization; this gate uses a fresh deterministic standard init
# plus first-batch k-means, but retains zero-mass EMA, reset50, historical
# epoch ordering, without-replacement donors, global reset RNG, and no warmup.
train_rqvae_healthy.train.arm_name = 'st5_historical_E2_zeromass_ema_reset50_probe'
train_rqvae_healthy.train.output_dir = 'out/rqvae/tiger_beauty_st5_historical_E2_zeromass_ema_reset50_probe_20260831'
train_rqvae_healthy.train.dataset_folder = 'dataset/amazon-p5-st5'
train_rqvae_healthy.train.dataset_split = 'beauty'
train_rqvae_healthy.train.expected_num_items = 12101
train_rqvae_healthy.train.seed = 20260701
train_rqvae_healthy.train.epochs = 1
train_rqvae_healthy.train.max_optimizer_steps = 1
train_rqvae_healthy.train.batch_size = 1024
train_rqvae_healthy.train.learning_rate = 0.001
train_rqvae_healthy.train.weight_decay = 0.0001
train_rqvae_healthy.train.warmup_steps = 0
train_rqvae_healthy.train.use_ema_codebook = True
train_rqvae_healthy.train.ema_decay = 0.99
train_rqvae_healthy.train.ema_initialization = 'zero_mass'
train_rqvae_healthy.train.ema_bootstrap_from_corpus = False
train_rqvae_healthy.train.dead_code_reset_every = 50
train_rqvae_healthy.train.use_kaiming_relu_initialization = False
train_rqvae_healthy.train.codebook_normalize = False
train_rqvae_healthy.train.gumbel_temperature = 0.2
train_rqvae_healthy.train.suffix_capacity = 256
train_rqvae_healthy.train.minimum_usage = 0.80
train_rqvae_healthy.train.snapshot_every_steps = 1
train_rqvae_healthy.train.stop_on_failed_health_gate = True
train_rqvae_healthy.train.epoch_ordering = 'historical_epoch_permutation'
train_rqvae_healthy.train.reset_donor_sampling = 'without_replacement'
train_rqvae_healthy.train.reset_rng_policy = 'global'
